# Copy to .env.production on the server and fill in the blanks. Never commit the real file.
# Random values: openssl rand -hex 24

POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=

# Public URLs
APP_URL=https://agent.example.com
KEYCLOAK_PUBLIC_URL=https://sso.example.com

# OIDC client (the same secret goes into the realm: bash deploy/render-realm.sh)
OIDC_ISSUER=https://sso.example.com/realms/routewise
OIDC_CLIENT_ID=ai-sales-agent
OIDC_CLIENT_SECRET=
SESSION_SECRET=

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Knowledge base: the RAG assistant on the same edge network, with its service token
KNOWLEDGE_URL=http://rag-knowledge-assistant:3000
KNOWLEDGE_TOKEN=

# Public demo protection: agent runs per day, nightly sandbox reset
DEMO_MODE=true
DAILY_RUN_LIMIT=40
MAX_TOOL_STEPS=8
