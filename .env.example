# PostgreSQL (see docker-compose.yml)
DATABASE_URL=postgres://agent:agent@localhost:5434/agent

# LLM: OpenAI chat completions with tool calling
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Knowledge base tool: the RAG assistant from the first demo (answers product questions with citations).
# Leave empty to fall back to the built-in product facts.
KNOWLEDGE_URL=https://rag.metamaker.ca
# Service token from the RAG assistant's SERVICE_TOKENS (optional; without it the public per-IP limit applies)
KNOWLEDGE_TOKEN=

# SSO (Keycloak, see keycloak/realm-export.json)
APP_URL=http://localhost:3002
OIDC_ISSUER=http://localhost:8081/realms/routewise
OIDC_CLIENT_ID=ai-sales-agent
OIDC_CLIENT_SECRET=dev-client-secret-change-me
# Random string, at least 32 characters, used to sign the session cookie
SESSION_SECRET=dev-session-secret-change-me-please-32chars

# Safety limits for one agent run
MAX_TOOL_STEPS=8
